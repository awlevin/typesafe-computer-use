TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
CLICKER_EMAIL=
# Optional: send the writer to any Anthropic-compatible endpoint instead of api.anthropic.com.
# The host root or the full .../v1/messages URL both work. Its key, if it checks one, goes in
# CLICKER_WRITER_API_KEY; ANTHROPIC_API_KEY is never sent there.
# CLICKER_WRITER_BASE_URL=http://localhost:1234
# CLICKER_WRITER_API_KEY=
# CLICKER_WRITER_MODEL=claude-haiku-4-5
# CLICKER_ANSWER_MODEL=claude-sonnet-5
